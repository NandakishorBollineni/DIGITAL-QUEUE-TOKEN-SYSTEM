# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
# In MongoDB Compass, use: mongodb://127.0.0.1:27017/digital_queue
MONGODB_URI=mongodb://127.0.0.1:27017/

# Database Name
DATABASE_NAME=digital_queue

# Service Timezone for daily queue date boundaries
SERVICE_TIMEZONE=Asia/Kolkata

# Server Port
PORT=5000

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Debug Mode
DEBUG=True
